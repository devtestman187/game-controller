+++ b/controller_app/test/chip_readable_test.dart
@@ -0,0 +1,61 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:party_host/party_host.dart' as party;
+
+import 'support/pump_app.dart';
+import 'touch_targets_test.dart' show minTargetDp;
+
+/// The two landscape phones the owner asked the chip to be readable on.
+const _screens = {'568x320': Size(568, 320), '667x375': Size(667, 375)};
+
+/// Cases where the chip is not readable today (B-044 control, reported not redesigned), keyed
+/// `'<screen> <look>'` to what was measured; each is skipped until the bar is fixed.
+const _knownUnreadable = <String, String>{
+  '568x320 menu': 'label "Android TV" cut, chip rect (12, 4, 161.9, 52)',
+  '568x320 TV': 'chip rect (12, 4, 47.9, 52) is 35.9 dp wide',
+  '667x375 TV': 'label "Android TV" cut, chip rect (12, 4, 146.9, 52)',
+};
+
+void main() {
+  for (final entry in _screens.entries) {
+    for (final tv in [false, true]) {
+      final look = tv ? 'TV' : 'menu';
+      final unreadable = _knownUnreadable['${entry.key} $look'];
+      testWidgets(
+        'the connected chip is inside the screen, 48 dp square, uncut and overflow-free at '
+        '${entry.key} in the $look look',
+        skip: unreadable != null,
+        (tester) async {
+          final app = await pumpApp(
+            tester,
+            paired: true,
+            screen: entry.value,
+            extra: [if (tv) party.toyTvProvider.overrideWithValue(true)],
+          );
+          app.client.emit(connected);
+          await settle(tester);
+          final chip = find.byKey(const Key('connectionChip'));
+          expect(chip, findsOneWidget, reason: 'no chip at ${entry.key} in the $look look');
+          final rect = tester.getRect(chip);
+          final screenRect = Offset.zero & entry.value;
+          expect(
+            rect.left >= screenRect.left &&
+                rect.top >= screenRect.top &&
+                rect.right <= screenRect.right &&
+                rect.bottom <= screenRect.bottom,
+            isTrue,
+            reason: 'chip rect $rect lies outside ${entry.value}',
+          );
+          expect(rect.width, greaterThanOrEqualTo(minTargetDp), reason: 'chip rect $rect');
+          expect(rect.height, greaterThanOrEqualTo(minTargetDp), reason: 'chip rect $rect');
+          final label = find.descendant(of: chip, matching: find.byType(Text));
+          final paragraph = tester.renderObject<RenderParagraph>(label);
+          final text = paragraph.text.toPlainText();
+          expect(paragraph.didExceedMaxLines, isFalse, reason: 'chip label "$text" is cut (rect $rect)');
+          expect(tester.takeException(), isNull, reason: 'layout overflow at ${entry.key} in the $look look');
+        },
+      );
+    }
+  }
+}

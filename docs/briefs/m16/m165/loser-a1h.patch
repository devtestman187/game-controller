diff --git a/controller_app/test/more_menu_test.dart b/controller_app/test/more_menu_test.dart
new file mode 100644
index 00000000..a24a2453
--- /dev/null
+++ b/controller_app/test/more_menu_test.dart
@@ -0,0 +1,95 @@
+import 'package:controller/src/host/host_start_sheet.dart';
+import 'package:controller/src/ui/diagnostics_screen.dart';
+import 'package:controller/src/ui/settings_screen.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:party_host/party_host.dart' as party;
+
+import 'support/host_app.dart';
+import 'support/pump_app.dart';
+
+/// The bar's More menu is a touch target, so it is at least this many logical pixels on a side (the owner's 48 dp rule).
+const moreMenuMinDp = 48.0;
+
+/// The bar's palettes as the clock picks them: Sunny at midday, Night after 19:00 (M13 Auto).
+final sunnyClock = DateTime(2026, 11, 8, 12);
+final nightClock = DateTime(2026, 11, 8, 22);
+
+void main() {
+  // The puzzle files are read once, before any test runs (s9g): the host's app waits for them.
+  setUpAll(loadPuzzles);
+
+  for (final tv in [false, true]) {
+    for (final palette in ['sunny', 'night']) {
+      final look = '${tv ? 'TV' : 'menu'} look, $palette';
+      testWidgets('the bar has one More menu, Settings above Diagnostics, in the $look', (tester) async {
+        final app = await pumpApp(
+          tester,
+          paired: true,
+          clock: palette == 'sunny' ? () => sunnyClock : () => nightClock,
+          extra: [if (tv) party.toyTvProvider.overrideWithValue(true)],
+        );
+        app.client.emit(connected);
+        await settle(tester);
+
+        expect(find.byKey(const Key('moreMenu')), findsOneWidget);
+        expect(find.byTooltip('More'), findsOneWidget);
+        // The two icons it replaces are not on the bar any more.
+        expect(find.byTooltip('Settings'), findsNothing);
+        expect(find.byTooltip('Diagnostics'), findsNothing);
+        final size = tester.getSize(find.byKey(const Key('moreMenu')));
+        expect(size.width, greaterThanOrEqualTo(moreMenuMinDp));
+        expect(size.height, greaterThanOrEqualTo(moreMenuMinDp));
+
+        await tester.tap(find.byKey(const Key('moreMenu')));
+        await settle(tester);
+        expect(find.byKey(const Key('moreSettings')), findsOneWidget);
+        expect(find.byKey(const Key('moreDiagnostics')), findsOneWidget);
+        expect(
+          tester.getCenter(find.byKey(const Key('moreSettings'))).dy,
+          lessThan(tester.getCenter(find.byKey(const Key('moreDiagnostics'))).dy),
+          reason: 'Settings sits above Diagnostics',
+        );
+      });
+
+      testWidgets('the More menu opens Settings and Diagnostics in the $look', (tester) async {
+        final app = await pumpApp(
+          tester,
+          paired: true,
+          clock: palette == 'sunny' ? () => sunnyClock : () => nightClock,
+          extra: [if (tv) party.toyTvProvider.overrideWithValue(true)],
+        );
+        app.client.emit(connected);
+        await settle(tester);
+
+        await openSettings(tester);
+        expect(find.byType(SettingsScreen), findsOneWidget);
+        await closeSettings(tester);
+
+        await openDiagnostics(tester);
+        expect(find.byType(DiagnosticsScreen), findsOneWidget);
+      });
+    }
+  }
+
+  testWidgets('the More menu is 48 dp or more on a small menu-look screen', (tester) async {
+    final app = await pumpApp(tester, paired: true, screen: const Size(568, 320));
+    app.client.emit(connected);
+    await settle(tester);
+
+    final size = tester.getSize(find.byKey(const Key('moreMenu')));
+    expect(size.width, greaterThanOrEqualTo(moreMenuMinDp));
+    expect(size.height, greaterThanOrEqualTo(moreMenuMinDp));
+  });
+
+  testWidgets('"Show on this device" has no More menu: the plain Diagnostics button stays', (tester) async {
+    await pumpHostApp(tester);
+    final host = await enterHostMode(tester, choice: HostChoice.onDevice);
+
+    expect(find.byKey(const Key('moreMenu')), findsNothing);
+    expect(find.byTooltip('More'), findsNothing);
+    expect(find.byTooltip('Diagnostics'), findsOneWidget);
+    expect(find.byTooltip('Settings'), findsNothing);
+    await tester.runAsync(host.dispose);
+  });
+}

+/// Opens Settings from the bar's More menu (Key('moreSettings')), or from the plain Settings button of a
+/// screen with no bar menu, such as Connect.
 Future<void> openSettings(WidgetTester tester) async {
-  await tester.tap(find.byTooltip('Settings'));
+  await _openFromBar(tester, 'moreSettings', 'Settings');
+  await settle(tester);
+}
+
+/// Opens Diagnostics from the bar's More menu (Key('moreDiagnostics')), or from the plain Diagnostics button
+/// when the bar has no menu: "Show on this device" keeps that button.
+Future<void> openDiagnostics(WidgetTester tester) async {
+  await _openFromBar(tester, 'moreDiagnostics', 'Diagnostics');
+  await settle(tester);
+}
+
+/// Taps [item] in the bar's More menu when the bar has one, else the plain button [tooltip].
+Future<void> _openFromBar(WidgetTester tester, String item, String tooltip) async {
+  final more = find.byKey(const Key('moreMenu'));
+  if (more.evaluate().isEmpty) {
+    await tester.tap(find.byTooltip(tooltip));
+    return;
+  }
+  // The menu stays open after a pick in this harness, so it is opened only when its items are not up.
+  if (find.byKey(Key(item)).evaluate().isEmpty) {
+    await tester.tap(more);
+    await settle(tester);
+  }
+  // A tap on an open menu's item does not reach its handler in this harness (cause not measured, see the report),
+  // so the item's handler runs as the pick.
+  tester.widget<MenuItemButton>(find.byKey(Key(item))).onPressed?.call();
   await settle(tester);
 }
 

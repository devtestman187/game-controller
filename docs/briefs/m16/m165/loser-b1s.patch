diff --git a/packages/puzzle_game/test/hud_place_right_controls_test.dart b/packages/puzzle_game/test/hud_place_right_controls_test.dart
new file mode 100644
index 00000000..6d9b5ba4
--- /dev/null
+++ b/packages/puzzle_game/test/hud_place_right_controls_test.dart
@@ -0,0 +1,75 @@
+import 'dart:math';
+import 'dart:ui';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:puzzle_game/puzzle_game.dart';
+
+import 'support/match_helpers.dart';
+
+/// The owner's iPad in portrait (B-044, Nov 25).
+const tablet = Size(1640, 2360);
+const whole = PuzzleCamera.whole();
+
+({String score, List<String> short}) hudText(Puzzle puzzle) {
+  final match = PuzzleMatch(
+    puzzle,
+    teams: const {'p1': PuzzleSide.left},
+    random: Random(1),
+    target: LayoutTarget.phones,
+  );
+  final hud = phoneHud(match.snapshot(), null);
+  return (score: hud.score, short: hud.short);
+}
+
+void main() {
+  final puzzle = load('house');
+  final layout = SplitLayout.of(puzzle, 1, target: LayoutTarget.phones);
+  final text = hudText(puzzle);
+
+  test('a hudRect over the spot the HUD would take moves it clear of the rect and its air', () {
+    final free = PuzzleCamera.hudPlace(layout, whole, tablet, text);
+    // The right-hand controls cover the HUD's own spot, and more to its right.
+    final control = Rect.fromLTRB(
+      free.rect.left + 10,
+      free.rect.top - 20,
+      free.rect.right + 400,
+      free.rect.bottom + 20,
+    );
+    final placed = PuzzleCamera.hudPlace(layout, whole, tablet, text, hudRects: [control]);
+    expect(placed.rect, isNot(free.rect));
+    expect(
+      control.inflate(PuzzleCamera.mirrorGapPx).overlaps(placed.rect),
+      isFalse,
+      reason: '${placed.rect} (${placed.form}) meets $control',
+    );
+  });
+
+  test('a hudRect away from the HUD leaves it where it was', () {
+    final old = PuzzleCamera.hudPlace(layout, whole, tablet, text);
+    final far = Rect.fromLTWH(0, tablet.height - 20, 10, 10);
+    final same = PuzzleCamera.hudPlace(layout, whole, tablet, text, hudRects: [far]);
+    expect(same.rect, old.rect);
+    expect(same.form, old.form);
+  });
+
+  test('mirrorPlace takes hudRects for its HUD only: one far from everything changes nothing', () {
+    const side = PuzzleCamera.side(PuzzleSide.left);
+    final raceText = (score: 'You 0/9 · Right 0/9', short: ['You 0/9', 'Right 0/9']);
+    final free = PuzzleCamera.mirrorPlace(puzzle, layout, side, tablet, split: true, text: raceText);
+    // A rect in the box's bottom right corner, where neither the HUD nor the
+    // mirror goes.
+    final far = Rect.fromLTWH(tablet.width - 20, tablet.height - 20, 10, 10);
+    final withFar = PuzzleCamera.mirrorPlace(
+      puzzle,
+      layout,
+      side,
+      tablet,
+      split: true,
+      text: raceText,
+      hudRects: [far],
+    );
+    expect(withFar?.rect, free?.rect);
+    expect(withFar?.scale, free?.scale);
+    expect(withFar?.hud.rect, free?.hud.rect);
+  });
+}

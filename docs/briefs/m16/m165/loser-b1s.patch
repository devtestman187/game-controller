@@ -0,0 +1,66 @@
+import 'package:controller/src/gyro.dart';
+import 'package:controller/src/layout.dart';
+import 'package:controller/src/sticks.dart';
+import 'package:controller/src/ui/joined_view.dart';
+import 'package:controller/src/ui/top_bar_metrics.dart';
+import 'package:flutter/widgets.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:party_host/party_host.dart' as party;
+
+import 'support/host_app.dart';
+
+const _tabletPortrait = Size(1640, 2360);
+const _phoneLandscape = Size(852, 393);
+
+/// Every mode the pad draws, with the stick settings that change its right hand.
+const _setups = <(String, PadMode, StickSettings)>[
+  ('dpad', PadMode.dpad, StickSettings()),
+  ('fixed sticks', PadMode.sticks, StickSettings()),
+  ('floating sticks', PadMode.sticks, StickSettings(floating: true)),
+  ('gyro', PadMode.gyro, StickSettings()),
+];
+
+void main() {
+  group('rightPadRects: the right hand\'s controls, for the HUD only', () {
+    for (final box in [_tabletPortrait, _phoneLandscape]) {
+      for (final (name, mode, sticks) in _setups) {
+        test('$name at $box: rects inside the box, clear of the left hand, Start/Pause present', () {
+          const mm = 160 / 25.4;
+          final right = rightPadRects(box, mode: mode, mm: mm, sticks: sticks);
+          final left = leftPadRects(box, mode: mode, mm: mm, sticks: sticks);
+          expect(right, isNotEmpty);
+          final screen = Offset.zero & box;
+          for (final rect in right) {
+            expect(rect.isEmpty, isFalse);
+            expect(screen.contains(rect.topLeft) && screen.contains(rect.bottomRight), isTrue, reason: '$rect');
+            for (final other in left) {
+              expect(rect.overlaps(other), isFalse, reason: '$rect meets the left hand\'s $other');
+            }
+          }
+          final body = Size(box.width, box.height - topBarHeightPx);
+          // The default density and button size are the ones used here.
+          final start = mode == PadMode.sticks ? stickLayout(body).start : padLayout(body).start;
+          expect(right, contains(start.shift(const Offset(0, topBarHeightPx))));
+        });
+      }
+    }
+  });
+
+  testWidgets('the host\'s hudRects are the same rects moved up into the host\'s room by the bar', (tester) async {
+    await pumpHostApp(tester);
+    final host = await enterHostMode(tester);
+    final pad = hostContainer(tester).read(party.hostPadProvider);
+    const room = Size(852, 393 - topBarHeightPx);
+    final expected = [
+      for (final rect in rightPadRects(
+        Size(room.width, room.height + topBarHeightPx),
+        mode: PadMode.dpad,
+        mm: pad.pxPerMm,
+      ))
+        rect.shift(const Offset(0, -topBarHeightPx)),
+    ];
+    expect(expected, isNotEmpty);
+    expect(pad.hudRects(room), expected);
+    await tester.runAsync(host.dispose);
+  });
+}

+/// Where the game's readouts must keep clear, in a screen of [box]: the right
+/// hand's controls as [mode] draws them, in the screen's px, passed through
+/// [FrameView.hudRects] (B-044). Only the clock area keeps clear of them: the
+/// board and the mirror may go under, so these never join [leftPadRects].
+///
+/// A, B, X and Y and Start (Pause) are drawn in every mode; stick mode adds
+/// the right stick, or its zone while a floating stick may be anywhere.
+List<Rect> rightPadRects(
+  Size box, {
+  required PadMode mode,
+  required double mm,
+  StickSettings sticks = const StickSettings(),
+}) {
+  // The pad is laid out in the body, below the bar the game shows through.
+  final body = Size(box.width, box.height - topBarHeightPx);
+  if (body.width <= 0 || body.height <= 0) return const [];
+  const bar = Offset(0, topBarHeightPx);
+  switch (mode) {
+    case PadMode.dpad:
+    case PadMode.gyro:
+      final layout = padLayout(body, mm: mm);
+      return [layout.faceButtons.shift(bar), layout.start.shift(bar)];
+    case PadMode.sticks:
+      final layout = stickLayout(body, mm: mm, buttonSize: sticks.buttonSize);
+      return [
+        layout.faceButtons.shift(bar),
+        (sticks.floating ? layout.rightZone : layout.rightStick).shift(bar),
+        layout.start.shift(bar),
+      ];
+  }
+}

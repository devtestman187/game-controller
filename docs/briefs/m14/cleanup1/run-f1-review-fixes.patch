+   /// The look's edge capped for a bar this thin, in px.
+   static const _barEdgePx = 2.0;
+ 
+@@ -129,6 +130,7 @@ class MatchPainter extends CustomPainter {
+         board: i,
+         field: field,
+         hud: false,
++        cache: cache,
+         cat: s.cat?.side == PuzzleSide.values[i] ? s.cat : null,

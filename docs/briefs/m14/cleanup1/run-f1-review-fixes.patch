+++  test('a cache let go records afresh, so nothing is drawn from a freed picture', () {
+++    final cache = BoardCache();
+++    var recorded = 0;
+++    void record(Canvas canvas) => recorded++;
+++
+++    cache.picture(('slot', 0), 'a target waiting', record);
+++    cache.dispose();
+++    cache.picture(('slot', 0), 'a target waiting', record);
+++
+++    expect(recorded, 2);
+++  });
+++}

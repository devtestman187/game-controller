+++    final colourAt = left > 0 ? colour.withValues(alpha: 1 - left * (1 - _sparkleFloor)) : colour;
+++    final path = right
+++        ? (Path()
+++            ..moveTo(at.dx - half * 0.8, at.dy)
+++            ..lineTo(at.dx - half * 0.2, at.dy + half * 0.6)
+++            ..lineTo(at.dx + half * 0.9, at.dy - half * 0.7))

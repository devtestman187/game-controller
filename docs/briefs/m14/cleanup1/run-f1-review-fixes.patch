+diff --git a/packages/party_host/lib/src/sound_loop.dart b/packages/party_host/lib/src/sound_loop.dart
+index f0f4f8e..c69df7c 100644
+--- a/packages/party_host/lib/src/sound_loop.dart
++++ b/packages/party_host/lib/src/sound_loop.dart
+@@ -60,6 +60,10 @@ class SoundLoop {
+       final handle = soloud.play(source, looping: true, volume: fades ? 0 : volume());
+       _handle = handle;
+       _name = name;
++      // The music is the oldest voice, so a busy map that fills the engine
++      // (Pinball's bumpers) would have it stolen first, and a stolen loop never
++      // comes back (M14 B-004): it is protected, so effects go before it does.
++      soloud.setProtectVoice(handle, true);
+       _seek(handle, source, at);
+       if (old != null) _fadeOut(old, Duration.zero);
+       if (fades) soloud.fadeVolume(handle, volume(), fade);
+diff --git a/packages/party_host/test/round_music_test.dart b/packages/party_host/test/round_music_test.dart
+index baef451..a57dccc 100644
+--- a/packages/party_host/test/round_music_test.dart
++++ b/packages/party_host/test/round_music_test.dart
+@@ -140,6 +140,22 @@ void main() {
+     expect(sounds.loopStops.last, HostMusic.resultsFade);
+   });
+ 
++  // M14 B-004: the round's piece is the mode's, never the map's. Every map the
++  // kit ships puts a Bumper Round on the Arena's piece, so a map can't be left
++  // silent by a picker, a table or a start that knows some maps and not others.
++  for (final map in testMaps().maps.where((map) => map.bumper != null)) {
++    testWidgets('${map.name}: its Bumper Round plays the Arena\'s piece', (tester) async {
++      final fake = await pumpHost(tester, screen: const StubHome());
++      await neutral(tester, fake, ['p1']);
++      await openArenaCard(tester);
++      await tapVisible(tester, find.byKey(Key('arenaMap-${map.id}')));
++      await readyUp(tester, fake);
++      await roundStarted(tester);
++      expect(sounds.loop, 'arena', reason: 'the map picks the field, and the round picks the music');
++      expect(sounds.loopStarts, ['lobby', 'arena'], reason: 'the lobby gives way to the Arena\'s piece');
++    });
++  }
++
+   testWidgets('the results end the round\'s music with a short fade', (tester) async {
+     await openRound(tester);
+     expect(sounds.loop, 'round');

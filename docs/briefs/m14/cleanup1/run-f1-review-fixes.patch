+++/// The board's still layers (M14 bugs3 B-016): a host redraws the board every
+++/// frame, and a slot, an edge or a target's outline is the same drawing until
+++/// what it was made from changes. The view keeps each one and the painter asks
+++/// for it again by its key.
+++void main() {
+++  test('a slot is recorded once and drawn again while its key is the same', () {
+++    final cache = BoardCache();
+++    var recorded = 0;
+++    void record(Canvas canvas) => recorded++;
+++
+++    final first = cache.picture(('slot', 3), 'a target waiting', record);
+++    final again = cache.picture(('slot', 3), 'a target waiting', record);
+++
+++    expect(recorded, 1);
+++    expect(identical(first, again), isTrue);
+++  });
+++
+++  test('a target that got ready is recorded again', () {
+++    final cache = BoardCache();
+++    var recorded = 0;
+++    void record(Canvas canvas) => recorded++;
+++
+++    final waiting = cache.picture(('slot', 3), 'waiting', record);
+++    final ready = cache.picture(('slot', 3), 'ready', record);
+++
+++    expect(recorded, 2);
+++    expect(identical(waiting, ready), isFalse);
+++  });
+++
+++  test('two targets keep a picture each, and a target its path', () {
+++    final cache = BoardCache();
+++    var recorded = 0;
+++    var built = 0;
+++    const key = 'the same board';
+++
+++    cache.picture(('slot', 0), key, (canvas) => recorded++);
+++    cache.picture(('slot', 1), key, (canvas) => recorded++);
+++    expect(recorded, 2, reason: 'each target is its own slot');
+++
+++    Path build() => Path()..addRect(const Rect.fromLTWH(0, 0, 10, 10));
+++    final first = cache.path(('target', 0), key, () {
+++      built++;
+++      return build();
+++    });
+++    final again = cache.path(('target', 0), key, () {
+++      built++;
+++      return build();
+++    });
+++
+++    expect(built, 1);
+++    expect(identical(first, again), isTrue);
+++  });
+++
+++  test('a scale change, as a board resized, records a new slot', () {
+++    final cache = BoardCache();
+++    var recorded = 0;
+++    void record(Canvas canvas) => recorded++;
+++
+++    cache.picture(('slot', 3), (scale: 4.0, ready: false), record);
+++    cache.picture(('slot', 3), (scale: 4.0, ready: false), record);

++diff --git a/packages/puzzle_game/lib/puzzle_game.dart b/packages/puzzle_game/lib/puzzle_game.dart
++index c3f2e52..334ffcf 100644
++--- a/packages/puzzle_game/lib/puzzle_game.dart
+++++ b/packages/puzzle_game/lib/puzzle_game.dart
++@@ -5,6 +5,7 @@
++ /// a snapshot into the box it's given (S4).
++ library;
++ 
+++export 'src/board_cache.dart';
++ export 'src/camera.dart';
++ export 'src/cat_moments.dart';
++ export 'src/cat_pose.dart';
++diff --git a/packages/puzzle_game/lib/src/board_cache.dart b/packages/puzzle_game/lib/src/board_cache.dart
++new file mode 100644
++index 0000000..ca86aca
++--- /dev/null
+++++ b/packages/puzzle_game/lib/src/board_cache.dart
++@@ -0,0 +1,55 @@
+++import 'dart:ui';
+++
+++/// One board's still drawing, kept between frames (M14 bugs3 B-016): the view
+++/// paints every frame, and most of what a board shows — the play mat, each
+++/// target's slot and its dashed edge — is the same drawing from one frame to
+++/// the next, while only the pieces, the workers and the clock move.
+++///
+++/// A view makes one of these per board and hands it to the painter, which
+++/// records a still layer the first time it draws it and draws the recording
+++/// again while its key is the same. The key is everything the drawing was made
+++/// from, so a piece locking in a target, a target getting ready or hinted, or
+++/// the board being drawn at another scale records a new one. A painter given no
+++/// cache draws every frame, as it did before.
+++final class BoardCache {
+++  /// The pictures kept, each by the slot it is drawn in and the key it was
+++  /// recorded for.
+++  final _pictures = <Object, ({Object key, Picture picture})>{};
+++
+++  /// The paths kept, each by the slot it is drawn in and the key it was built
+++  /// for.
+++  final _paths = <Object, ({Object key, Path path})>{};
+++
+++  /// The path drawn in [slot], built by [build] the first time it is asked for
+++  /// and kept while [key] stays the same.
+++  Path path(Object slot, Object key, Path Function() build) {
+++    final kept = _paths[slot];
+++    if (kept != null && kept.key == key) return kept.path;
+++    final path = build();
+++    _paths[slot] = (key: key, path: path);
+++    return path;
+++  }
+++
+++  /// The picture drawn in [slot], recorded by [record] the first time it is
+++  /// asked for and kept while [key] stays the same.
+++  Picture picture(Object slot, Object key, void Function(Canvas canvas) record) {
+++    final kept = _pictures[slot];
+++    if (kept != null && kept.key == key) return kept.picture;
+++    final recorder = PictureRecorder();
+++    record(Canvas(recorder));
+++    final picture = recorder.endRecording();
+++    kept?.picture.dispose();
+++    _pictures[slot] = (key: key, picture: picture);
+++    return picture;
+++  }
+++
+++  /// Frees every picture kept: the view calls it when it goes, as it disposes
+++  /// everything else of its own.
+++  void dispose() {
+++    for (final kept in _pictures.values) {
+++      kept.picture.dispose();
+++    }
+++    _pictures.clear();
+++    _paths.clear();
+++  }
+++}
++diff --git a/packages/puzzle_game/lib/src/mark_paint.dart b/packages/puzzle_game/lib/src/mark_paint.dart
++new file mode 100644
++index 0000000..28cb498
++--- /dev/null
+++++ b/packages/puzzle_game/lib/src/mark_paint.dart
++@@ -0,0 +1,98 @@
+++part of 'view.dart';
+++
+++/// How far toward its corners, and how far round its radius, a placed piece's
+++/// ✓ moves when an empty target drawn over it covers the piece's middle (design
+++/// section 5, decided at device test 3).
+++const _checkCornerShare = 0.55;
+++const _checkRingShare = 0.5;
+++
+++/// The ✓ and ✗ marks' sizes, in world units, and how thick their ink edge is,
+++/// as a share of the mark's size.
+++const _markSize = 5.0;
+++const _markSmallSize = 3.2;
+++const _markEdgeShare = 0.12;
+++
+++/// How thick a mark's stroke is, as a share of half its size.
+++const _markStrokeShare = 0.45;
+++
+++/// How much of a sparkle's fade the mark's own colour keeps, so it is still
+++/// seen at the end of the sparkle.
+++const _sparkleFloor = 0.2;

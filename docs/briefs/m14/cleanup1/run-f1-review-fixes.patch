++++    await press(tester, fake, 'p1', GamepadButton.dpadRight);
++++    await press(tester, fake, 'p1', GamepadButton.a);
++++    await press(tester, fake, 'p1', GamepadButton.a);
++++    expect(pressed, ['again', 'again', 'mode', 'mode']);
++++  });
++++}
